prefix=/workspaces/calendar-engine/lib/glfw
exec_prefix=${prefix}
includedir=/workspaces/calendar-engine/lib/glfw/include
libdir=/workspaces/calendar-engine/lib/glfw/lib

Name: GLFW
Description: A multi-platform library for OpenGL, window and input
Version: 3.5.1
URL: https://www.glfw.org/
Requires.private: 
Libs: -L${libdir} -lglfw3
Libs.private: -lrt -lm -ldl
Cflags: -I${includedir}
